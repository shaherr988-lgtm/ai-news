# Database
DATABASE_URL=postgresql+psycopg2://ai_news:ai_news@localhost:5432/ai_news

# Postgres container credentials (used by docker/docker-compose.yml only —
# must match the credentials embedded in DATABASE_URL above)
POSTGRES_DB=ai_news
POSTGRES_USER=ai_news
POSTGRES_PASSWORD=ai_news

# LLM provider (generation) — "openai", "anthropic", or "gemini". Only the
# matching API key is required. Gemini is free-tier-friendly (see below) and
# shares GEMINI_API_KEY with the embedding provider.
LLM_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
GEMINI_MODEL=gemini-3.6-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Safety ceiling on LLM calls per run — Gemini's free tier caps
# generate_content at 20/day total, so 15 leaves margin if using Gemini for
# LLM_PROVIDER (1 call is always reserved for the final digest build). Set
# generously (e.g. 1000) for a paid provider with no such daily cap.
LLM_DAILY_CALL_BUDGET=15

# Embedding provider (RAG chat) — "openai" or "gemini".
# NOTE: Anthropic has no text-embeddings endpoint, so this is independent of
# LLM_PROVIDER — you can summarize with Anthropic and still need one of these.
# Gemini is the free-tier-friendly option: an aistudio.google.com API key
# works without adding billing, unlike OpenAI. embedding_dim MUST match the
# active provider/model (768 for gemini-embedding-001, 1536 for
# text-embedding-3-small) — the pgvector column size is fixed at table
# creation, so switching providers means recreating article_chunks.
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIM=768
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# RAG chunking / retrieval
RAG_CHUNK_SIZE_CHARS=1000
RAG_CHUNK_OVERLAP_CHARS=150
RAG_TOP_K=5

# Email — "gmail" (SMTP + app password), "outlook" (Microsoft 365
# organizational accounts only — BLOCKED for personal Outlook.com accounts,
# Microsoft disables SMTP AUTH server-side with no user-facing toggle), or
# "brevo" (recommended for personal accounts — a dedicated transactional
# email service, free tier 300/day, no personal-account restrictions).
# Gmail app password: https://myaccount.google.com/apppasswords
# Brevo SMTP credentials: app.brevo.com -> Settings -> SMTP & API -> SMTP tab
#   BREVO_SENDER_EMAIL must be a verified sender (Senders, Domains & Dedicated IPs)
EMAIL_PROVIDER=brevo
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
OUTLOOK_ADDRESS=
OUTLOOK_APP_PASSWORD=
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SENDER_EMAIL=
DIGEST_RECIPIENT_EMAIL=

# Optional: Webshare (or similar) residential proxy for YouTube transcript
# fetching. Usually not needed for local development — only when running from
# a datacenter host (e.g. Render), which YouTube tends to block transcript
# requests from without one.
PROXY_USERNAME=
PROXY_PASSWORD=

# Optional HTTP Basic Auth for the web app — leave both blank for plain
# localhost use. Set both if you expose the app beyond your own machine
# (e.g. a temporary public tunnel).
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# Secret token for POST /internal/run-daily — a free external cron service
# (e.g. cron-job.org) calls this URL with ?token=... once a day to trigger
# the pipeline, since Render's own Cron Job service has no free tier.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RUN_DAILY_TOKEN=
